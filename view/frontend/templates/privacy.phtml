<?php
/**
 * Copyright © 2026 Roman Pasichnyk
 * SPDX-License-Identifier: OSL-3.0 OR AFL-3.0
 *
 * My Account > Privacy: download everything the store keeps about the
 * customer (JSON), and, when the store allows it, delete the account with
 * the password and a confirmation box (an account without a password: an
 * emailed link). Plain forms with the form key, no script.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Consent\ViewModel\Privacy $config
 */
$config = $block->getData('config');
$policyUrl = $config->policyUrl();
?>
<div class="zero-privacy flex flex-col gap-10 max-w-2xl">
    <section class="flex flex-col gap-3" aria-labelledby="zero-privacy-download">
        <h2 id="zero-privacy-download" class="text-xl font-medium"><?= $escaper->escapeHtml(__('Download my data')) ?></h2>
        <p class="text-sm text-base-content/70">
            <?= $escaper->escapeHtml(__('One file with everything we keep about you: your account and addresses, orders, newsletter, reviews, wish list and carts, and what other parts of the store saved for you. It is JSON, readable and easy to move to another service.')) ?>
        </p>
        <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('privacy/account/export')) ?>">
            <?= $block->getBlockHtml('formkey') ?>
            <button type="submit" class="btn btn-primary" data-privacy-export><?= $escaper->escapeHtml(__('Download my data')) ?></button>
        </form>
    </section>

    <section class="flex flex-col gap-3 border-t border-base-300 pt-8" aria-labelledby="zero-privacy-delete">
        <h2 id="zero-privacy-delete" class="text-xl font-medium"><?= $escaper->escapeHtml(__('Delete my account')) ?></h2>
        <?php if ($config->allowsDeletion()): ?>
            <p class="text-sm text-base-content/70">
                <?= $escaper->escapeHtml(__('Your account, addresses, wish list, saved carts, newsletter subscription and alerts are deleted for good. Your reviews and comments stay, without your name.')) ?>
                <?php if ($config->anonymizesOrders()): ?>
                    <?= $escaper->escapeHtml(__('Your orders stay in our accounts with their amounts and items, but without your name, email, addresses and phone number.')) ?>
                <?php else: ?>
                    <?= $escaper->escapeHtml(__('Your orders and invoices stay as they were issued, because the law asks us to keep them.')) ?>
                <?php endif; ?>
                <?= $escaper->escapeHtml(__('This cannot be undone: download your data first if you want a copy.')) ?>
            </p>
            <?php $needsPassword = $config->needsPassword(); ?>
            <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('privacy/account/delete')) ?>" class="flex flex-col gap-4" data-privacy-delete>
                <?= $block->getBlockHtml('formkey') ?>
                <?php if ($needsPassword): ?>
                    <label class="flex flex-col gap-1">
                        <span class="text-sm font-semibold"><?= $escaper->escapeHtml(__('Your password')) ?></span>
                        <input type="password" name="password" required autocomplete="current-password" class="input input-bordered w-full max-w-xs">
                    </label>
                <?php else: ?>
                    <p class="text-sm text-base-content/70"><?= $escaper->escapeHtml(__('Your account has no password, so we email you a link that deletes it.')) ?></p>
                <?php endif; ?>
                <label class="flex items-start gap-2 text-sm cursor-pointer">
                    <input type="checkbox" name="confirm" value="1" required class="checkbox checkbox-sm mt-0.5">
                    <span><?= $escaper->escapeHtml(__('I understand that my account and personal data will be deleted and cannot be restored.')) ?></span>
                </label>
                <div>
                    <button type="submit" class="btn btn-outline"><?= $escaper->escapeHtml($needsPassword ? __('Delete my account') : __('Email me a link to delete my account')) ?></button>
                </div>
            </form>
        <?php else: ?>
            <p class="text-sm text-base-content/70">
                <?= $escaper->escapeHtml(__('To delete your account and your personal data, write to us from the email address of your account. We will confirm when it is done.')) ?>
            </p>
        <?php endif; ?>
    </section>

    <?php if ($policyUrl !== ''): ?>
        <p class="text-sm">
            <a class="link" href="<?= $escaper->escapeUrl(str_starts_with($policyUrl, '/') ? $block->getBaseUrl() . ltrim($policyUrl, '/') : $policyUrl) ?>">
                <?= $escaper->escapeHtml(__('How we use your data: our privacy policy')) ?>
            </a>
        </p>
    <?php endif; ?>
</div>
