    Emailed links that delete an account without a password
    (Model\Privacy\DeletionRequests): one per account, the token as its
    SHA-256, expires_at in UTC.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="zero_privacy_deletion" resource="default" engine="innodb" comment="Zero Privacy Account Deletion Link">
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="token_hash" nullable="false" length="64" comment="SHA-256 of the Token"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="expires_at" nullable="false" comment="Expires At (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ZERO_PRIVACY_DELETION_TOKEN_HASH">
            <column name="token_hash"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ZERO_PRIVACY_DELETION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="zero_privacy_deletion" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
